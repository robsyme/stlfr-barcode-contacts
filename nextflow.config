manifest {
    name            = 'stlfr-barcode-contacts'
    description     = 'Barcode co-occurrence contact maps from stLFR linked reads'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.10.0'
}

// Nothing here names a particular bucket, queue or compute environment. Supply the
// output directory (-output-dir or outputDir), the work directory and the executor at
// launch. Containers are built from the conda directives by Wave (see the wave profile)
// or the conda directives are used directly (conda profile).

aws.batch.maxSpotAttempts = 5

process {
    errorStrategy = 'retry'
    maxRetries    = 2

    cpus   = 2
    memory = { 4.GB * task.attempt }
    time   = { 2.h * task.attempt }

    withName: 'FETCH_READS' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'TAG_BARCODES' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'PREPARE_REFERENCE' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
    }
    withName: 'BWAMEM2_INDEX' {
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withName: 'ALIGN' {
        cpus   = 16
        memory = { 32.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }
    withName: 'MERGE_MARKDUP' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withName: 'BARCODE_MATRIX' {
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withName: 'MAKE_BCM' {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
}

profiles {
    conda {
        conda.enabled = true
    }
    wave {
        docker.enabled = true
        wave.enabled   = true
        wave.strategy  = 'conda,container'
    }
    // Shrink requests so a stub or toy run fits on a laptop.
    local_small {
        process {
            cpus   = 1
            memory = 1.GB
            withName: '.*' {
                cpus   = 2
                memory = 2.GB
            }
        }
    }
}
